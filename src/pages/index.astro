---
import BaseHead from '../components/BaseHead.astro';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kim Jeske | Senior leader focused on product and customer experiences</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --page-bg: #fcfafa;
            --frame-bg: #e7e5df;
            --card-bg: #ffffff;
            --card-bg-subtle: #ffffffe6;
            --text: #202124;
            --text-subtle: #666;
            --text-muted: #8a857e;
            --border: #dfddd7;
            --button-bg: #111;
            --button-text: #fff;
            --font-heading: 'Space Grotesk', sans-serif;
            --font-body: 'Inter', system-ui, -apple-system, sans-serif;
        }

        * { box-sizing: border-box; }

        html { background: var(--frame-bg); }

        body {
            background: var(--page-bg);
            color: var(--text);
            font-family: var(--font-body);
            margin: 0;
            line-height: 1.6;
            font-size: 16px;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .container-narrow {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        main { padding-top: 2rem; }
        section { padding: 5rem 0; }

        /* Header */
        .site-header {
            background: var(--page-bg);
            border-bottom: 1px solid var(--border);
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 1.5rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .logo {
            font-family: var(--font-heading);
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--text);
            text-decoration: none;
            letter-spacing: -0.03em;
        }

        .main-nav { display: none; gap: 2.5rem; }

        .main-nav a {
            color: var(--text-subtle);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9375rem;
            transition: color 0.3s ease;
        }

        .main-nav a:hover { color: var(--text); }

        .mobile-menu-button {
            background: none;
            border: 1px solid var(--border);
            border-radius: 999px;
            color: var(--text);
            cursor: pointer;
            display: flex;
            padding: 0.5rem;
        }

        .mobile-menu {
            display: none;
            padding: 0 1.5rem 1rem;
        }

        .mobile-menu.is-open { display: block; }

        .mobile-menu a {
            display: block;
            padding: 0.5rem 0;
            color: var(--text-subtle);
            text-decoration: none;
            font-weight: 500;
        }

        /* Hero */
        .hero {
            text-align: center;
            padding: 6rem 0 2rem;
        }

        .hero h1 {
            font-family: var(--font-heading);
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 600;
            letter-spacing: -0.04em;
            margin: 0 0 1rem;
            line-height: 1.05;
        }

        .hero .subtitle {
            font-family: var(--font-heading);
            font-size: clamp(1.75rem, 3vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.03em;
            color: var(--text);
            margin: 0 0 0.75rem;
        }

        .hero .tagline {
            font-size: 1.125rem;
            color: var(--text-muted);
            max-width: 42rem;
            margin: 0 auto;
        }

        /* Section headings */
        .section-heading {
            font-family: var(--font-heading);
            font-size: clamp(1.75rem, 3vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.03em;
            margin: 0 0 0.5rem;
            text-align: center;
        }

        .section-subheading {
            color: var(--text-subtle);
            text-align: center;
            max-width: 42rem;
            margin: 0 auto 3rem;
            font-size: 1.0625rem;
        }

        /* Strategic Impact */
        .impact-grid { display: grid; gap: 1.5rem; }

        .impact-card {
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 1rem;
            border: 1px solid var(--border);
        }

        .impact-role {
            font-size: 1.125rem;
            font-weight: 600;
            margin: 0 0 0.25rem;
        }

        .impact-company {
            color: var(--text-subtle);
            font-weight: 500;
            margin: 0 0 0.25rem;
        }

        .impact-dates {
            font-size: 0.875rem;
            color: var(--text-muted);
            font-weight: 500;
            margin: 0 0 1rem;
        }

        .impact-card ul { margin: 0; padding: 0; list-style: none; }

        .impact-card li {
            position: relative;
            padding-left: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--text-subtle);
        }

        .impact-card li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.6em;
            width: 5px;
            height: 5px;
            background: var(--text);
            border-radius: 50%;
        }

        .impact-note {
            margin-top: 0.75rem;
            font-size: 0.9375rem;
            color: var(--text-muted);
            font-style: italic;
        }

        /* Recognition */
        .recognition-section { background: var(--card-bg); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

        .recognition-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; max-width: 48rem; margin: 0 auto; }

        .recognition-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            padding: 2.5rem;
            border-radius: 1rem;
            text-align: center;
        }

        .recognition-badge {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-bottom: 0.75rem;
        }

        .recognition-card h3 {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -0.03em;
            margin: 0 0 0.5rem;
        }

        .recognition-card p { color: var(--text-subtle); margin: 0; }

        /* Case Studies */
        .case-studies-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }

        .case-study-card {
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 1rem;
            text-decoration: none;
            color: inherit;
            display: block;
            border: 1px solid var(--border);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .case-study-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06);
            border-color: #ccc;
        }

        .case-study-tag {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            background: #f4f2ef;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            margin-bottom: 0.75rem;
        }

        .case-study-card h3 {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            margin: 0 0 0.5rem;
        }

        .case-study-card p {
            color: var(--text-subtle);
            margin: 0 0 1rem;
            font-size: 0.9375rem;
        }

        .case-study-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text);
            font-weight: 500;
            font-size: 0.9375rem;
            text-decoration: none;
        }

        .case-study-card:hover .case-study-link { opacity: 0.7; }

        /* Speaking & Writing */
        .content-list {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
        }

        .content-item {
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: 1rem;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            justify-content: center;
            border: 1px solid var(--border);
            transition: border-color 0.3s ease;
            aspect-ratio: 1;
        }

        .content-item:hover { border-color: #bbb; }

        .content-type {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 0.25rem;
        }

        .content-item h3 {
            font-family: var(--font-heading);
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            margin: 0 0 0.25rem;
            line-height: 1.3;
        }

        .content-meta {
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        /* Contact */
        .contact-section { background: var(--card-bg); border-top: 1px solid var(--border); }

        .contact-section .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .contact-section h2 {
            font-family: var(--font-heading);
            font-size: clamp(1.75rem, 3vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.03em;
            margin: 0 0 0.25rem;
        }

        .contact-section p {
            color: var(--text-subtle);
            margin: 0;
            font-size: 1.0625rem;
        }

        .contact-button {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--button-bg);
            color: var(--button-text);
            font-weight: 600;
            padding: 0.875rem 2rem;
            border-radius: 999px;
            text-decoration: none;
            font-size: 0.9375rem;
            transition: opacity 0.3s ease;
        }

        .contact-button:hover { opacity: 0.85; }

        /* Footer */
        .site-footer {
            border-top: 1px solid var(--border);
            padding: 2rem 0;
        }

        .footer-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .footer-content p {
            color: var(--text-muted);
            font-size: 0.875rem;
            margin: 0;
        }

        @media (min-width: 768px) {
            .main-nav { display: flex; }
            .mobile-menu-button { display: none; }
            .impact-grid { grid-template-columns: 1fr 1fr; }
            .case-studies-grid { grid-template-columns: 1fr 1fr; }
            .footer-content { flex-direction: row; justify-content: space-between; }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="header-content">
            <a href="/" class="logo">Kim Jeske</a>
            <nav class="main-nav">
                <a href="/about">About</a>
                <a href="/case-study">Case Studies</a>
                <a href="#speaking-writing">Speaking &amp; Writing</a>
            </nav>
            <button id="mobile-menu-button" class="mobile-menu-button">
                <i data-lucide="menu" width="20" height="20"></i>
            </button>
        </div>
        <div id="mobile-menu" class="mobile-menu">
            <a href="/about">About</a>
            <a href="/case-study">Case Studies</a>
            <a href="#speaking-writing">Speaking &amp; Writing</a>
        </div>
    </header>

    <main>
        <!-- Hero -->
        <section class="hero">
            <div class="container">
                <p class="subtitle">Senior leader focused on product and customer experiences</p>
                <p class="tagline">I believe great leadership starts with emotional intelligence and radical candor. I care deeply about investing in careers and creating an environment where everyone can do their best work. My approach combines technical excellence with customer-first thinking—building cross-functional teams that ship iteratively and measure what matters.</p>
            </div>
        </section>

        <!-- What I Do -->
        <section>
            <div class="container">
                <h2 class="section-heading">What I Do</h2>
                <p class="section-subheading">In-depth case studies about my key projects and their impact</p>

                <div class="case-studies-grid">
                    <a href="/case-study/cloudflare-docs" class="case-study-card">
                        <span class="case-study-tag">2020 - Present</span>
                        <h3>Transforming Cloudflare's Documentation</h3>
                        <p>Building an award-winning documentation platform from zero</p>
                        <span class="case-study-link">
                            Read case study <i data-lucide="arrow-right" width="16" height="16"></i>
                        </span>
                    </a>
                    <a href="/case-study" class="case-study-card" style="display: flex; align-items: center; justify-content: center; text-align: center;">
                        <span style="font-family: var(--font-heading); font-size: 1.125rem;">
                            View all case studies <i data-lucide="arrow-right" width="18" height="18" style="vertical-align: middle; margin-left: 0.25rem;"></i>
                        </span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Strategic Impact -->
        <section id="case-studies">
            <div class="container">
                <h2 class="section-heading">Strategic Impact</h2>
                <p class="section-subheading">Building and leading high-performing teams at scale</p>

                <div class="impact-grid">
                    <div class="impact-card">
                        <h3 class="impact-role">Senior Director, Head of Product Content and Content Engineering</h3>
                        <p class="impact-company">Cloudflare</p>
                        <p class="impact-dates">2020 - 2026</p>
                        <ul>
                            <li>Led team of 30+ tech writers, UX content strategists, and engineers</li>
                            <li>Scaled docs infrastructure to serve 5M+ developers monthly</li>
                            <li>Transformed docs into a developer tool using Cloudflare products</li>
                        </ul>
                    </div>

                    <div class="impact-card">
                        <h3 class="impact-role">Group Manager, Technical Communication</h3>
                        <p class="impact-company">National Instruments</p>
                        <p class="impact-dates">2016 - 2018</p>
                        <ul>
                            <li>Led team of technical writers supporting Semiconductor Test System</li>
                            <li>Established technical communication policies and streamlined documentation workflows</li>
                        </ul>
                        <p class="impact-note">Earlier career included progressive technical writing roles at National Instruments.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Recognition -->
        <section class="recognition-section">
            <div class="container">
                <h2 class="section-heading">Awards &amp; Recognition</h2>
                <div class="recognition-grid">
                    <div class="recognition-card">
                        <div class="recognition-badge">Winner</div>
                        <h3>2025 DevPortal Awards</h3>
                        <p>Cloudflare Docs — Best Unified Enterprise Developer Portal</p>
                    </div>
                    <div class="recognition-card">
                        <div class="recognition-badge">Extraordinary Award</div>
                        <h3>Cloudflare</h3>
                        <p>Recognized for exceptional contributions and leadership</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Speaking & Writing -->
        <section id="speaking-writing" class="recognition-section">
            <div class="container">
                <h2 class="section-heading">Speaking &amp; Writing</h2>
                <p class="section-subheading" style="margin-bottom: 2rem;">Talks, webinars, and articles about strategy and leadership</p>

                <div class="content-list">
                    <a href="https://www.youtube.com/watch?v=IoRKCXbfGvQ" class="content-item" target="_blank">
                        <div class="content-type">Webinar</div>
                        <h3>Technical content is the product</h3>
                        <p class="content-meta">The Content Wrangler · 2022</p>
                    </a>

                    <a href="https://world.productledalliance.com/location/austin/" class="content-item" target="_blank">
                        <div class="content-type">Conference</div>
                        <h3>From first click to forever customer: The role of UX in product-led success</h3>
                        <p class="content-meta">Product Led Alliance Austin · 2025</p>
                    </a>

                    <a href="https://blog.cloudflare.com/content-as-a-product/" class="content-item" target="_blank">
                        <div class="content-type">Blog</div>
                        <h3>How we treat content as a product</h3>
                        <p class="content-meta">Cloudflare Blog · 2022</p>
                    </a>

                    <a href="https://blog.cloudflare.com/open-source-all-the-way-down-upgrading-our-developer-documentation/" class="content-item" target="_blank">
                        <div class="content-type">Blog</div>
                        <h3>Open source all the way down: Upgrading our developer documentation</h3>
                        <p class="content-meta">Cloudflare Blog · 2025</p>
                    </a>
                </div>
            </div>
        </section>

        <!-- Let's Connect -->
        <section class="contact-section">
            <div class="container">
                <div>
                    <h2>Let's Connect</h2>
                    <p>I'm always open to discussing new opportunities and collaborations.</p>
                </div>
                <a href="https://www.linkedin.com/in/kimberlyjeske/" class="contact-button" target="_blank">
                    <i data-lucide="linkedin" width="20" height="20"></i>
                    Connect on LinkedIn
                </a>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2026 Kim Jeske. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide && typeof window.lucide.createIcons === 'function') {
                window.lucide.createIcons();
            }

            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');

            if (mobileMenuButton && mobileMenu) {
                mobileMenuButton.addEventListener('click', () => {
                    mobileMenu.classList.toggle('is-open');
                });
            }

            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    const targetId = this.getAttribute('href');
                    if (targetId && targetId !== '#') {
                        const targetElement = document.querySelector(targetId);
                        if (targetElement) {
                            e.preventDefault();
                            if (mobileMenu && mobileMenu.classList.contains('is-open')) {
                                mobileMenu.classList.remove('is-open');
                            }
                            targetElement.scrollIntoView({ behavior: 'smooth' });
                        }
                    }
                });
            });
        });
    </script>
</body>
</html>
