---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kim Jeske | Consulting</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --page-bg: #fcfafa;
            --frame-bg: #e7e5df;
            --card-bg: #ffffff;
            --card-bg-subtle: #ffffffe6;
            --text: #202124;
            --text-subtle: #666;
            --text-muted: #8a857e;
            --border: #dfddd7;
            --button-bg: #000;
            --button-text: #fff;
            --accent: #202124;
            --font-heading: 'Space Grotesk', sans-serif;
            --font-body: 'Inter', system-ui, -apple-system, sans-serif;
        }

        * { box-sizing: border-box; }
        html { background: var(--frame-bg); scroll-behavior: smooth; }

        body {
            background: var(--page-bg);
            color: var(--text);
            font-family: var(--font-body);
            margin: 0;
            line-height: 1.6;
            font-size: 16px;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .container-narrow {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        section { padding: 5rem 0; }

        /* Header */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(252, 250, 250, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.5rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .logo {
            font-family: var(--font-heading);
            font-size: 1.35rem;
            font-weight: 600;
            color: var(--text);
            text-decoration: none;
            letter-spacing: -0.03em;
        }

        .main-nav { display: none; align-items: center; gap: 2rem; }

        .main-nav a {
            color: var(--text-subtle);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9375rem;
            transition: color 0.3s ease;
        }

        .main-nav a:hover { color: var(--text); }

        .nav-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--button-bg);
            color: var(--button-text);
            font-weight: 600;
            padding: 0.625rem 1.5rem;
            border-radius: 999px;
            text-decoration: none;
            font-size: 0.875rem;
            border: 1px solid var(--border);
            transition: background 0.2s ease, border-color 0.2s ease;
        }

        .nav-cta:hover {
            background: #1a1a1a;
            border-color: #999;
        }

        .mobile-menu-button {
            background: none;
            border: 1px solid var(--border);
            border-radius: 999px;
            color: var(--text);
            cursor: pointer;
            display: flex;
            padding: 0.5rem;
        }

        .mobile-menu {
            display: none;
            padding: 0 1.5rem 1rem;
        }

        .mobile-menu.is-open { display: block; }

        .mobile-menu a {
            display: block;
            padding: 0.5rem 0;
            color: var(--text-subtle);
            text-decoration: none;
            font-weight: 500;
        }

        /* Hero */
        .hero {
            text-align: center;
            padding: 7rem 0 5rem;
        }

        .hero-eyebrow {
            display: inline-block;
            font-size: 0.8125rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        .hero h1 {
            font-family: var(--font-heading);
            font-size: clamp(2.5rem, 5.5vw, 4rem);
            font-weight: 600;
            letter-spacing: -0.04em;
            margin: 0 0 1.25rem;
            line-height: 1.05;
            max-width: 14em;
            margin-left: auto;
            margin-right: auto;
        }

        .hero .tagline {
            font-size: 1.125rem;
            color: var(--text-subtle);
            max-width: 36rem;
            margin: 0 auto 2.5rem;
            line-height: 1.7;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .button-primary {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--button-bg);
            color: var(--button-text);
            font-weight: 600;
            padding: 1rem 2.25rem;
            border-radius: 999px;
            text-decoration: none;
            font-size: 1rem;
            transition: opacity 0.3s ease;
        }

        .button-primary:hover { opacity: 0.85; }

        .button-secondary {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: transparent;
            color: var(--text);
            font-weight: 500;
            padding: 1rem 2rem;
            border-radius: 999px;
            text-decoration: none;
            font-size: 1rem;
            border: 1px solid var(--border);
            transition: border-color 0.3s ease;
        }

        .button-secondary:hover { border-color: #bbb; }

        /* Social Proof */
        .social-proof {
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            padding: 2.5rem 0;
        }

        .social-proof-label {
            text-align: center;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        .social-proof-items {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 1.5rem 2.5rem;
        }

        .social-proof-item {
            font-family: var(--font-heading);
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-subtle);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .social-proof-item i { width: 18px; height: 18px; opacity: 0.5; }

        .social-proof-divider {
            width: 4px;
            height: 4px;
            background: var(--border);
            border-radius: 50%;
            display: none;
        }

        @media (min-width: 768px) {
            .social-proof-divider { display: block; }
        }

        /* Section headings */
        .section-label {
            text-align: center;
            font-size: 0.8125rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-bottom: 0.75rem;
        }

        .section-heading {
            font-family: var(--font-heading);
            font-size: clamp(1.75rem, 3.5vw, 2.5rem);
            font-weight: 600;
            letter-spacing: -0.03em;
            margin: 0 0 0.75rem;
            text-align: center;
        }

        .section-subheading {
            color: var(--text-subtle);
            text-align: center;
            max-width: 36rem;
            margin: 0 auto 3.5rem;
            font-size: 1.0625rem;
        }

        /* Services */
        .services-grid {
            display: grid;
            gap: 1.5rem;
        }

        .service-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 2.5rem;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .service-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.04);
        }

        .service-number {
            font-family: var(--font-heading);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .service-card h3 {
            font-family: var(--font-heading);
            font-size: 1.35rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            margin: 0 0 0.75rem;
        }

        .service-card p {
            color: var(--text-subtle);
            margin: 0 0 1.25rem;
            font-size: 0.9375rem;
            line-height: 1.7;
        }

        .service-outcomes {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .service-outcomes li {
            position: relative;
            padding-left: 1.5rem;
            margin-bottom: 0.5rem;
            color: var(--text-subtle);
            font-size: 0.9375rem;
        }

        .service-outcomes li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.55em;
            width: 6px;
            height: 6px;
            background: var(--text);
            border-radius: 50%;
        }

        /* Case Studies */
        .case-studies-section { background: var(--card-bg); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

        .case-studies-grid {
            display: grid;
            gap: 1.5rem;
        }

        .case-study-card {
            background: var(--page-bg);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 2rem;
            text-decoration: none;
            color: inherit;
            display: block;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .case-study-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06);
            border-color: #ccc;
        }

        .case-study-tag {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            background: #f4f2ef;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            margin-bottom: 1rem;
        }

        .case-study-card h3 {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            margin: 0 0 0.5rem;
        }

        .case-study-card p {
            color: var(--text-subtle);
            margin: 0 0 1rem;
            font-size: 0.9375rem;
            line-height: 1.6;
        }

        .case-study-result {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .case-study-result span {
            display: flex;
            align-items: center;
            gap: 0.375rem;
        }

        .case-study-result i { width: 16px; height: 16px; }

        /* About */
        .about-grid {
            display: grid;
            gap: 2.5rem;
            align-items: start;
        }

        .about-photo {
            border-radius: 1rem;
            width: 100%;
            max-width: 300px;
            display: block;
            border: 1px solid var(--border);
        }

        .about-text {
            font-size: 1.0625rem;
            color: var(--text-subtle);
            line-height: 1.8;
        }

        .about-text p { margin: 0 0 1.25rem; }
        .about-text p:last-child { margin-bottom: 0; }

        /* Contact */
        .contact-section {
            border-top: 1px solid var(--border);
            background: var(--card-bg);
        }

        .contact-inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 2rem;
        }

        .contact-inner h2 {
            font-family: var(--font-heading);
            font-size: clamp(1.75rem, 3vw, 2.25rem);
            font-weight: 600;
            letter-spacing: -0.03em;
            margin: 0 0 0.5rem;
        }

        .contact-inner p {
            color: var(--text-subtle);
            margin: 0;
            font-size: 1.0625rem;
            max-width: 30rem;
        }

        /* Footer */
        .site-footer {
            border-top: 1px solid var(--border);
            padding: 2rem 0;
        }

        .footer-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
        }

        .footer-links a {
            color: var(--text-subtle);
            text-decoration: none;
            font-size: 0.875rem;
            transition: color 0.3s ease;
        }

        .footer-links a:hover { color: var(--text); }

        .footer-content p {
            color: var(--text-muted);
            font-size: 0.875rem;
            margin: 0;
        }

        @media (min-width: 768px) {
            .main-nav { display: flex; }
            .mobile-menu-button { display: none; }
            .services-grid { grid-template-columns: repeat(3, 1fr); }
            .case-studies-grid { grid-template-columns: repeat(3, 1fr); }
            .about-grid { grid-template-columns: 300px 1fr; }
            .footer-content { flex-direction: row; justify-content: space-between; }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="header-content">
            <a href="/" class="logo">Kim Jeske</a>
            <nav class="main-nav">
                <a href="#services">Services</a>
                <a href="/case-study">Case Studies</a>
                <a href="/about">About</a>
                <a href="https://www.linkedin.com/in/kimberlyjeske/" class="nav-cta" target="_blank">
                    Book a call <i data-lucide="arrow-right" width="16" height="16"></i>
                </a>
            </nav>
            <button id="mobile-menu-button" class="mobile-menu-button">
                <i data-lucide="menu" width="20" height="20"></i>
            </button>
        </div>
        <div id="mobile-menu" class="mobile-menu">
            <a href="#services">Services</a>
            <a href="/case-study">Case Studies</a>
            <a href="/about">About</a>
            <a href="https://www.linkedin.com/in/kimberlyjeske/" target="_blank">Book a call</a>
        </div>
    </header>

    <main>
        <!-- Hero -->
        <section class="hero">
            <div class="container">
                <p class="hero-eyebrow">Product Content &amp; Content Engineering Leader</p>
                <h1>I transform developer documentation into a product.</h1>
                <p class="tagline">From zero to industry-leading. I've built and led documentation orgs at Cloudflare and National Instruments&thinsp;—&thinsp;now I help companies build AI and human-friendly docs from the ground up.</p>
                <div class="hero-actions">
                    <a href="https://www.linkedin.com/in/kimberlyjeske/" class="button-primary" target="_blank">
                        Book a free consultation <i data-lucide="arrow-right" width="18" height="18"></i>
                    </a>
                    <a href="/case-study" class="button-secondary">
                        See case studies
                    </a>
                </div>
            </div>
        </section>

        <!-- Social Proof -->
        <section class="social-proof">
            <div class="container">
                <p class="social-proof-label">Experience &amp; Recognition</p>
                <div class="social-proof-items">
                    <span class="social-proof-item"><i data-lucide="building-2"></i> Cloudflare</span>
                    <span class="social-proof-item"><i data-lucide="building-2"></i> National Instruments</span>
                    <span class="social-proof-item"><i data-lucide="clock"></i> 15+ years</span>
                    <span class="social-proof-item"><i data-lucide="award"></i> DevPortal Awards 2025 Winner</span>
                </div>
            </div>
        </section>

        <!-- Services -->
        <section id="services">
            <div class="container">
                <p class="section-label">Services</p>
                <h2 class="section-heading">How I can help</h2>
                <p class="section-subheading">Three ways I partner with companies to build documentation that drives developer adoption.</p>

                <div class="services-grid">
                    <div class="service-card">
                        <p class="service-number">01</p>
                        <h3>Strategy Consulting</h3>
                        <p>Documentation roadmaps, content-as-product transformation, org design, and tooling evaluation.</p>
                        <ul class="service-outcomes">
                            <li>A clear plan and roadmap for your documentation investment</li>
                            <li>Content-as-product methodology tailored to your stack</li>
                            <li>Tooling and platform recommendations</li>
                        </ul>
                    </div>

                    <div class="service-card">
                        <p class="service-number">02</p>
                        <h3>Build &amp; Scale</h3>
                        <p>Building AI and human-friendly docs from the ground up. Hiring, workflows, and content operations.</p>
                        <ul class="service-outcomes">
                            <li>A documentation system ready for AI consumption and human readers</li>
                            <li>Hiring playbook and team structure</li>
                            <li>Content operations and publishing workflows</li>
                        </ul>
                    </div>

                    <div class="service-card">
                        <p class="service-number">03</p>
                        <h3>Advisory / Fractional</h3>
                        <p>Ongoing part-time leadership: regular strategy sessions, mentorship, and guidance for documentation leaders.</p>
                        <ul class="service-outcomes">
                            <li>Executive-level documentation leadership without full-time commitment</li>
                            <li>Biweekly strategy and mentorship sessions</li>
                            <li>Direct support for your documentation team lead</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Case Studies -->
        <section class="case-studies-section">
            <div class="container">
                <p class="section-label">Case Studies</p>
                <h2 class="section-heading">Proven results</h2>
                <p class="section-subheading">Real transformations from my work building documentation orgs and platforms.</p>

                <div class="case-studies-grid">
                    <a href="/case-study/cloudflare-docs" class="case-study-card">
                        <span class="case-study-tag">Documentation Strategy</span>
                        <h3>Cloudflare Docs</h3>
                        <p>Built an award-winning documentation platform and 25+ person team from zero.</p>
                        <div class="case-study-result">
                            <span><i data-lucide="users"></i> Team: 0 → 25+</span>
                            <span><i data-lucide="bar-chart-3"></i> 5M+ devs/month</span>
                            <span><i data-lucide="award"></i> DevPortal Award</span>
                        </div>
                    </a>

                    <a href="/case-study/ni-sts" class="case-study-card">
                        <span class="case-study-tag">Documentation Strategy</span>
                        <h3>NI Semiconductor Test System</h3>
                        <p>First-to-market documentation for a new product category. Built the team and strategy from scratch.</p>
                        <div class="case-study-result">
                            <span><i data-lucide="users"></i> Team: 1 → 4-5</span>
                            <span><i data-lucide="package"></i> First-to-market docs</span>
                        </div>
                    </a>

                    <a href="/case-study/crochetly" class="case-study-card">
                        <span class="case-study-tag">AI Leadership</span>
                        <h3>AI Documentation Transformation</h3>
                        <p>How hands-on R&D became the proof-of-concept for driving organizational AI adoption.</p>
                        <div class="case-study-result">
                            <span><i data-lucide="sparkles"></i> AI-assisted content pipeline</span>
                            <span><i data-lucide="lightbulb"></i> Influenced org AI strategy</span>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- About -->
        <section>
            <div class="container">
                <p class="section-label">About</p>
                <h2 class="section-heading">Who I am</h2>

                <div class="about-grid">
                    <img src="/KimJeske.jpg" alt="Kim Jeske" class="about-photo" loading="lazy">

                    <div class="about-text">
                        <p>I've spent the last decade building documentation teams and content systems from the ground up. As Senior Director at Cloudflare, I grew a team from zero to 25+ and scaled developer documentation to 5M+ monthly visitors&thinsp;—&thinsp;earning a 2025 DevPortal Award for Best Unified Enterprise Developer Portal. Before that, I led documentation for National Instruments' Semiconductor Test System, a first-to-market product category that required building both the team and the strategy from scratch.</p>
                        <p>Now I help companies skip the years of trial and error. I show them how to build developer documentation that's AI-, agent-, and human-friendly&thinsp;—&thinsp;designed to drive developer adoption from day one.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section class="contact-section">
            <div class="container">
                <div class="contact-inner">
                    <div>
                        <h2>Let's work together</h2>
                        <p>Whether you're building docs from scratch or scaling an existing team&thinsp;—&thinsp;I'd love to hear about what you're working on.</p>
                    </div>
                    <a href="https://www.linkedin.com/in/kimberlyjeske/" class="button-primary" target="_blank">
                        <i data-lucide="linkedin" width="20" height="20"></i>
                        Message me on LinkedIn
                    </a>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2026 Kim Jeske. All rights reserved.</p>
                <div class="footer-links">
                    <a href="#services">Services</a>
                    <a href="/case-study">Case Studies</a>
                    <a href="/about">About</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide && typeof window.lucide.createIcons === 'function') {
                window.lucide.createIcons();
            }

            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');

            if (mobileMenuButton && mobileMenu) {
                mobileMenuButton.addEventListener('click', () => {
                    mobileMenu.classList.toggle('is-open');
                });
            }

            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    const targetId = this.getAttribute('href');
                    if (targetId && targetId !== '#') {
                        const targetElement = document.querySelector(targetId);
                        if (targetElement) {
                            e.preventDefault();
                            if (mobileMenu && mobileMenu.classList.contains('is-open')) {
                                mobileMenu.classList.remove('is-open');
                            }
                            targetElement.scrollIntoView({ behavior: 'smooth' });
                        }
                    }
                });
            });
        });
    </script>
</body>
</html>
