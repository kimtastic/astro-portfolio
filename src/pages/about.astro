---
import BaseHead from '../components/BaseHead.astro';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About | Kim Jeske</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --page-bg: #fcfafa;
            --frame-bg: #e7e5df;
            --card-bg: #ffffff;
            --text: #202124;
            --text-subtle: #666;
            --text-muted: #8a857e;
            --border: #dfddd7;
            --button-bg: #111;
            --button-text: #fff;
            --font-heading: 'Space Grotesk', sans-serif;
            --font-body: 'Inter', system-ui, -apple-system, sans-serif;
        }

        * { box-sizing: border-box; }

        html { background: var(--frame-bg); }

        body {
            background: var(--page-bg);
            color: var(--text);
            font-family: var(--font-body);
            margin: 0;
            line-height: 1.7;
            font-size: 16px;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        main {
            padding-top: 6rem;
            padding-bottom: 5rem;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-subtle);
            text-decoration: none;
            font-weight: 500;
            margin-bottom: 3rem;
            transition: color 0.3s ease;
        }

        .back-link:hover { color: var(--text); }

        .page-header { margin-bottom: 3rem; }

        .page-header h1 {
            font-family: var(--font-heading);
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 600;
            letter-spacing: -0.04em;
            margin: 0 0 0.5rem;
            line-height: 1.05;
        }

        .page-header .subtitle {
            color: var(--text-subtle);
            font-size: 1.0625rem;
            margin: 0;
        }

        .about-photo { float: left; width: 40%; margin: 0 2rem 1rem 0; }

        .about-photo img {
            width: 100%;
            border-radius: 1rem;
            display: block;
            border: 1px solid var(--border);
        }

        .about-text p {
            color: var(--text-subtle);
            margin-bottom: 1.25rem;
            font-size: 1.0625rem;
        }

        .about-text p:last-child { margin-bottom: 0; }

        .side-project {
            clear: both;
            margin-top: 4rem;
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 1rem;
            border: 1px solid var(--border);
            border-left: 4px solid var(--text);
        }

        .side-project-tag {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            background: #f4f2ef;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            margin-bottom: 0.75rem;
        }

        .side-project h3 {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            margin: 0 0 0.5rem;
        }

        .side-project p {
            color: var(--text-subtle);
            margin: 0 0 1rem;
        }

        .side-project a {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9375rem;
        }

        .side-project a:hover { opacity: 0.7; }

        .contact-section {
            margin-top: 4rem;
            padding: 3rem;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 1rem;
        }

        .contact-section .contact-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .contact-section h2 {
            font-family: var(--font-heading);
            font-size: 1.75rem;
            font-weight: 600;
            letter-spacing: -0.03em;
            margin: 0 0 0.25rem;
        }

        .contact-section p {
            color: var(--text-subtle);
            margin: 0;
        }

        .contact-button {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--button-bg);
            color: var(--button-text);
            font-weight: 600;
            padding: 0.875rem 2rem;
            border-radius: 999px;
            text-decoration: none;
            font-size: 0.9375rem;
            transition: opacity 0.3s ease;
        }

        .contact-button:hover { opacity: 0.85; }

        .site-footer {
            border-top: 1px solid var(--border);
            padding: 2rem 0;
            text-align: center;
        }

        .site-footer p {
            color: var(--text-muted);
            font-size: 0.875rem;
            margin: 0;
        }

        @media (min-width: 768px) {
            .hobbies-grid { grid-template-columns: repeat(3, 1fr); }
        }
    </style>
</head>
<body>
    <main>
        <div class="container">
            <a href="/" class="back-link">
                <i data-lucide="arrow-left" width="20" height="20"></i>
                Back to Home
            </a>

            <header class="page-header">
                <h1>A Few Words About Me</h1>
                <p class="subtitle">Product Content and Content Engineering Leader</p>
            </header>

            <div class="about-photo">
                <img src="/KimJeske.jpg" alt="Kim Jeske" loading="lazy">
            </div>

            <div class="about-text">
                <p>I lead teams that build documentation and content experiences that help developers succeed. My work sits at the intersection of content strategy, user experience, and team leadership.</p>

                <p>I started as a technical writer, and for a long time, that was exactly where I wanted to be. I loved the craft — making complex things clear, finding the right structure, writing for real people with real questions.</p>

                <p>But somewhere along the way, I noticed I was spending more and more time with the people around me. Thinking through their career goals. Sitting with their drafts not just to fix them, but to understand how they saw the work. A mentor once told me I had a gift for listening and giving feedback that landed. I didn't set out to become a manager — it grew out of what I was already doing.</p>
            </div>

            <div class="side-project">
                <span class="side-project-tag">Side Project</span>
                <h3>Crochetly</h3>
                <p>My documentation site about crochet</p>
                <a href="https://crochetly.com/" target="_blank">
                    Visit Crochetly <i data-lucide="external-link" width="16" height="16"></i>
                </a>
            </div>

            <section class="contact-section">
                <div class="contact-inner">
                    <div>
                        <h2>Get in Touch</h2>
                        <p>I'd love to connect with you.</p>
                    </div>
                    <a href="https://www.linkedin.com/in/kimberlyjeske/" class="contact-button" target="_blank">
                        <i data-lucide="linkedin" width="20" height="20"></i>
                        Connect on LinkedIn
                    </a>
                </div>
            </section>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>&copy; 2026 Kim Jeske. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide && typeof window.lucide.createIcons === 'function') {
                window.lucide.createIcons();
            }
        });
    </script>
</body>
</html>
